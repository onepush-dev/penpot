# Penpot 2.18.3 on Railway: every variable with its TEMPLATE expression.
# ${{secret(N, ...)}} values are generated per deploy; everything else is a literal or a reference.
# Nothing here needs to be filled in at deploy time.

### penpot-frontend (public, domain -> port 8080, health /, start command in railway/penpot-frontend-start-command.txt)
PENPOT_PUBLIC_URI=https://${{RAILWAY_PUBLIC_DOMAIN}}
PENPOT_FLAGS=${{penpot-backend.PENPOT_FLAGS}}
PENPOT_BACKEND_URI=http://penpot-backend
PENPOT_EXPORTER_URI=http://penpot-exporter
PENPOT_BACKEND_HOST=${{penpot-backend.RAILWAY_PRIVATE_DOMAIN}}
PENPOT_EXPORTER_HOST=${{penpot-exporter.RAILWAY_PRIVATE_DOMAIN}}
PENPOT_HTTP_SERVER_MAX_BODY_SIZE=367001600
PORT=8080

### penpot-backend (private, port 6060, health /readyz, volume /opt/data/assets, start command in railway/penpot-backend-start-command.txt)
PENPOT_FLAGS=enable-registration enable-login-with-password disable-email-verification enable-prepl-server
PENPOT_PUBLIC_URI=${{penpot-frontend.PENPOT_PUBLIC_URI}}
PENPOT_SECRET_KEY=${{secret(64, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")}}
PENPOT_DATABASE_URI=postgresql://${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.PGDATABASE}}
PENPOT_DATABASE_USERNAME=${{Postgres.PGUSER}}
PENPOT_DATABASE_PASSWORD=${{Postgres.PGPASSWORD}}
PENPOT_REDIS_URI=redis://default:${{Valkey.VALKEY_PASSWORD}}@${{Valkey.RAILWAY_PRIVATE_DOMAIN}}:6379/0
PENPOT_OBJECTS_STORAGE_BACKEND=fs
PENPOT_OBJECTS_STORAGE_FS_DIRECTORY=/opt/data/assets
PENPOT_HTTP_SERVER_HOST=::
PENPOT_HTTP_SERVER_PORT=6060
PENPOT_HTTP_SERVER_MAX_BODY_SIZE=367001600
PENPOT_HTTP_SERVER_MAX_MULTIPART_BODY_SIZE=367001600
PORT=6060
JAVA_OPTS=-Xms256m -Xmx1g
RAILWAY_RUN_UID=0

### penpot-exporter (private, port 6061, health /readyz)
PENPOT_FLAGS=${{penpot-backend.PENPOT_FLAGS}}
PENPOT_PUBLIC_URI=${{penpot-frontend.PENPOT_PUBLIC_URI}}
PENPOT_SECRET_KEY=${{penpot-backend.PENPOT_SECRET_KEY}}
PENPOT_REDIS_URI=${{penpot-backend.PENPOT_REDIS_URI}}
PENPOT_INTERNAL_URI=http://${{penpot-frontend.RAILWAY_PRIVATE_DOMAIN}}:8080
PENPOT_HTTP_SERVER_PORT=6061
PORT=6061

### Valkey (valkey/valkey:8.1.10, private, port 6379, no volume, no start command)
VALKEY_PASSWORD=${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")}}
VALKEY_EXTRA_FLAGS=--requirepass ${{VALKEY_PASSWORD}} --maxmemory 128mb --maxmemory-policy volatile-lfu
REDISHOST=${{RAILWAY_PRIVATE_DOMAIN}}
REDISPORT=6379
REDISUSER=default
REDIS_URL=redis://default:${{VALKEY_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:6379

### Postgres (Railway postgres template, ghcr.io/railwayapp-templates/postgres-ssl:18.6, volume /var/lib/postgresql/data)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")}}
POSTGRES_DB=railway
PGDATA=/var/lib/postgresql/data/pgdata
PGHOST=${{RAILWAY_PRIVATE_DOMAIN}}
PGPORT=5432
PGUSER=${{POSTGRES_USER}}
PGPASSWORD=${{POSTGRES_PASSWORD}}
PGDATABASE=${{POSTGRES_DB}}
DATABASE_URL=postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}
SSL_CERT_DAYS=820
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60

# --- Optional, add on penpot-backend after deploy (not in the template) ---
# Email (invitations, password reset, verification). Also add enable-smtp to PENPOT_FLAGS.
# Railway allows outbound SMTP only on the Pro plan and above.
# PENPOT_SMTP_DEFAULT_FROM=no-reply@example.com
# PENPOT_SMTP_DEFAULT_REPLY_TO=no-reply@example.com
# PENPOT_SMTP_HOST=
# PENPOT_SMTP_PORT=587
# PENPOT_SMTP_USERNAME=
# PENPOT_SMTP_PASSWORD=
# PENPOT_SMTP_TLS=true
# PENPOT_SMTP_SSL=false
# Telemetry (off unless set): PENPOT_TELEMETRY_ENABLED=true
